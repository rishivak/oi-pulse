# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://oi_pulse:changeme@localhost:5432/oi_pulse
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Token encryption (AES-256-GCM) ──────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY

# ─── Session cookies ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=REPLACE_WITH_32_BYTE_HEX
SESSION_TTL_SECONDS=86400

# ─── Upstox OAuth 2.0 ────────────────────────────────────────────────────────
# Obtain client credentials from https://developer.upstox.com → My Apps
UPSTOX_CLIENT_ID=REPLACE
UPSTOX_CLIENT_SECRET=REPLACE
# For Podman local dev, route OAuth callback through nginx on port 8080.
UPSTOX_REDIRECT_URI=http://localhost:8080/api/auth/callback

# Daily OAuth Access Token (generated via OAuth 2.0 login / callback exchange)
# 1. Authorize dialog: GET https://api.upstox.com/v2/login/authorization/dialog?response_type=code&client_id={CLIENT_ID}&redirect_uri={REDIRECT_URI}
# 2. Exchange code: POST https://api.upstox.com/v2/login/authorization/token
UPSTOX_ACCESS_TOKEN=REPLACE_WITH_FRESH_UPSTOX_ACCESS_TOKEN

# Upstox base URLs (do not change unless Upstox publishes new versions)
UPSTOX_API_BASE=https://api.upstox.com/v2
UPSTOX_AUTH_BASE=https://api.upstox.com/v2/login/authorization

# ─── Collector defaults ───────────────────────────────────────────────────────
DEFAULT_INTERVAL_MIN=5
COLLECTOR_UNDERLYINGS=NIFTY,BANKNIFTY,SENSEX
MARKET_TZ=Asia/Kolkata

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Frontend (Vercel) ────────────────────────────────────────────────────────
# Only the public base URL of the backend API — no secrets here
NEXT_PUBLIC_API_URL=http://localhost:8000
